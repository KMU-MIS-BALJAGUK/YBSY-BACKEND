# 복사해서 .env 로 만들고 값을 채우세요 (.env 는 절대 커밋 금지).
#   PowerShell: Copy-Item .env.example .env
# 실제 값은 팀 채널에서 공유받습니다. Spring(local 프로필)과 docker compose 가 같이 읽습니다.

# ---- 로컬 MySQL (docker-compose.yml) ----
MYSQL_ROOT_PASSWORD=
DB_USERNAME=ybsy
DB_PASSWORD=
# 기본값: jdbc:mysql://localhost:3306/ybsy?serverTimezone=UTC&characterEncoding=UTF-8
# DB_URL=

# ---- 서버 ----
# SERVER_PORT=8080
# 프론트 출처, 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 인증 (Google 로그인 이슈에서 사용) ----
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# JWT 서명 키(32바이트 이상 무작위 Base64). 생성 예: openssl rand -base64 48
# JWT_SECRET=

# ---- AI (AI 추천 이슈에서 사용) ----
# ANTHROPIC_API_KEY=
